      "name": "TestAuthentication",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const ResponseBody = pm.response.json();\r",
              "pm.test(\"Validate Status Code is 200\",function(){\r",
              "pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Validate Response contains results[] array\",function(){\r",
              " pm.expect(ResponseBody.results).to.be.an(\"array\");\r",
              "});\r",
              "pm.test(\"Validate That Movie Titles Are Relevant To The Search Keyword'\",function(){\r",
              "    ResponseBody.results.forEach(function(movie){\r",
              "        pm.expect(movie.title.toLowerCase()).to.include(\"inception\");\r",
              "    });\r",
              "});\r",
              "pm.test(\"Validate Each Result Includes: id, title, release_date, overview\",function(){\r",
              "    ResponseBody.results.forEach(function(movie){\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"overview\");\r",
              "        pm.expect(movie).to.have.property(\"release_date\");\r",
              "    });\r",
              "});\r",
              "pm.test(\"Confirm total_results > 0\", function () {\r",
              "    pm.expect(ResponseBody.total_results).to.be.above(0);\r",
              "});"
